{
  "description": "frontmatter の判定のケース。Markdown を直接読む側（lib/markdown-posts.ts）と、API の取り込み側の検証の両方のテストがこのケースを流し、同じ判定になることを確かめる。file はディレクトリの直下に置くファイル名（省略時は a.md）、lines は中身の行。expect は post（記事として読む。draft と title も比べる）、error（読まずにエラー）、ignored（エラーにせず読まない）。work が true のケースは作品として読む（付帯情報 badge、tech、repository を許す。API の取り込み側は作品しか読まないので、付帯情報のキーを書くケースは必ず work: true にする）。作品として読む post のケースは、badge、tech、repository（書いていなければ無し）も比べる。",
  "cases": [
    {
      "name": "draft: true は下書き",
      "lines": ["---","title: t","summary: s","publishedAt: 2026-10-01T09:00:00+09:00","draft: true","---","本文"],
      "expect": "post",
      "draft": true,
      "title": "t"
    },
    {
      "name": "draft が無ければ公開",
      "lines": ["---","title: t","summary: s","publishedAt: 2026-10-01T09:00:00+09:00","---","本文"],
      "expect": "post",
      "draft": false,
      "title": "t"
    },
    {
      "name": "コロンの後に空白の無い draft:true はエラー",
      "lines": ["---","title: t","summary: s","publishedAt: 2026-10-01T09:00:00+09:00","draft:true","---","本文"],
      "expect": "error"
    },
    {
      "name": "先頭の行の draft:true もエラー",
      "lines": ["---","draft:true","title: t","summary: s","publishedAt: 2026-10-01T09:00:00+09:00","---","本文"],
      "expect": "error"
    },
    {
      "name": "大文字の Draft: true はエラー",
      "lines": ["---","title: t","summary: s","publishedAt: 2026-10-01T09:00:00+09:00","Draft: true","---","本文"],
      "expect": "error"
    },
    {
      "name": "Marp の記事でも Draft: true はエラー",
      "lines": ["---","title: t","summary: s","publishedAt: 2026-10-01T09:00:00+09:00","marp: true","Draft: true","---","# スライド"],
      "expect": "error"
    },
    {
      "name": "インデントした draft: true はエラー",
      "lines": ["---","title: t","summary: s","publishedAt: 2026-10-01T09:00:00+09:00","  draft: true","---","本文"],
      "expect": "error"
    },
    {
      "name": "先頭の行のインデントした draft: true もエラー",
      "lines": ["---","  draft: true","title: t","summary: s","publishedAt: 2026-10-01T09:00:00+09:00","---","本文"],
      "expect": "error"
    },
    {
      "name": "タブでインデントした draft: true はエラー",
      "lines": ["---","title: t","summary: s","publishedAt: 2026-10-01T09:00:00+09:00","\tdraft: true","---","本文"],
      "expect": "error"
    },
    {
      "name": "値の無いキーの下にインデントした draft: true はエラー",
      "lines": ["---","title: t","summary: s","publishedAt: 2026-10-01T09:00:00+09:00","marp: true","style:","  draft: true","---","# スライド"],
      "expect": "error"
    },
    {
      "name": "ブロックの中の draft: true は style の中身（下書きではない）",
      "lines": ["---","title: t","summary: s","publishedAt: 2026-10-01T09:00:00+09:00","marp: true","style: |","  section { color: black; }","  draft: true","---","# スライド"],
      "expect": "post",
      "draft": false,
      "title": "t"
    },
    {
      "name": ". で始まる .md はエラー",
      "file": ".hidden.md",
      "lines": ["---","title: t","summary: s","publishedAt: 2026-10-01T09:00:00+09:00","draft: true","---","本文"],
      "expect": "error"
    },
    {
      "name": ". で始まる .md でないファイルは読まない",
      "file": ".gitkeep",
      "lines": [""],
      "expect": "ignored"
    },
    {
      "name": "コロンの後がタブの draft はエラー",
      "lines": ["---","title: t","summary: s","publishedAt: 2026-10-01T09:00:00+09:00","draft:\ttrue","---","本文"],
      "expect": "error"
    },
    {
      "name": "コロンの前に空白のある draft はエラー",
      "lines": ["---","title: t","summary: s","publishedAt: 2026-10-01T09:00:00+09:00","draft : true","---","本文"],
      "expect": "error"
    },
    {
      "name": "同じキーが 2 回あればエラー（後の値で上書きしない）",
      "lines": ["---","title: t","summary: s","publishedAt: 2026-10-01T09:00:00+09:00","draft: true","draft: false","---","本文"],
      "expect": "error"
    },
    {
      "name": "YAML 1.1 の yes は真",
      "lines": ["---","title: t","summary: s","publishedAt: 2026-10-01T09:00:00+09:00","draft: yes","---","本文"],
      "expect": "post",
      "draft": true,
      "title": "t"
    },
    {
      "name": "全部大文字の OFF は偽",
      "lines": ["---","title: t","summary: s","publishedAt: 2026-10-01T09:00:00+09:00","draft: OFF","---","本文"],
      "expect": "post",
      "draft": false,
      "title": "t"
    },
    {
      "name": "draft の後ろのコメントは読まない",
      "lines": ["---","title: t","summary: s","publishedAt: 2026-10-01T09:00:00+09:00","draft: true # 下書き","---","本文"],
      "expect": "post",
      "draft": true,
      "title": "t"
    },
    {
      "name": "引用符で囲んだ \"true\" は文字列なのでエラー",
      "lines": ["---","title: t","summary: s","publishedAt: 2026-10-01T09:00:00+09:00","draft: \"true\"","---","本文"],
      "expect": "error"
    },
    {
      "name": "y は真偽値ではないのでエラー",
      "lines": ["---","title: t","summary: s","publishedAt: 2026-10-01T09:00:00+09:00","draft: y","---","本文"],
      "expect": "error"
    },
    {
      "name": "大文字小文字の混ざった tRUE は真偽値ではないのでエラー",
      "lines": ["---","title: t","summary: s","publishedAt: 2026-10-01T09:00:00+09:00","draft: tRUE","---","本文"],
      "expect": "error"
    },
    {
      "name": "空行と行頭のコメントは読み飛ばす",
      "lines": ["---","# メモ","title: t","","   ","summary: s","publishedAt: 2026-10-01T09:00:00+09:00","---","本文"],
      "expect": "post",
      "draft": false,
      "title": "t"
    },
    {
      "name": "先頭の BOM は 1 つだけ取り除く",
      "lines": ["\uFEFF---","title: t","summary: s","publishedAt: 2026-10-01T09:00:00+09:00","---","本文"],
      "expect": "post",
      "draft": false,
      "title": "t"
    },
    {
      "name": "BOM が 2 つあればエラー",
      "lines": ["\uFEFF\uFEFF---","title: t","summary: s","publishedAt: 2026-10-01T09:00:00+09:00","---","本文"],
      "expect": "error"
    },
    {
      "name": "CRLF の改行は LF にそろえる",
      "lines": ["---\r","title: t\r","summary: s\r","publishedAt: 2026-10-01T09:00:00+09:00\r","draft: true\r","---\r","本文\r"],
      "expect": "post",
      "draft": true,
      "title": "t"
    },
    {
      "name": "frontmatter が無ければエラー",
      "lines": ["# 本文だけ"],
      "expect": "error"
    },
    {
      "name": "閉じの --- が無ければエラー",
      "lines": ["---","title: t","summary: s","publishedAt: 2026-10-01T09:00:00+09:00","本文"],
      "expect": "error"
    },
    {
      "name": "空の frontmatter は title などが無いのでエラー",
      "lines": ["---","---","本文"],
      "expect": "error"
    },
    {
      "name": "リストの行はエラー",
      "lines": ["---","title: t","summary: s","publishedAt: 2026-10-01T09:00:00+09:00","- item","---","本文"],
      "expect": "error"
    },
    {
      "name": "英字でないキーはエラー",
      "lines": ["---","títle: t","summary: s","publishedAt: 2026-10-01T09:00:00+09:00","---","本文"],
      "expect": "error"
    },
    {
      "name": "未知のキー __proto__ はエラー",
      "lines": ["---","title: t","summary: s","publishedAt: 2026-10-01T09:00:00+09:00","__proto__: x","---","本文"],
      "expect": "error"
    },
    {
      "name": "YAML が真偽値として読むキー（on）はエラー",
      "lines": ["---","title: t","summary: s","publishedAt: 2026-10-01T09:00:00+09:00","on: x","---","本文"],
      "expect": "error"
    },
    {
      "name": "制御文字を含む行はエラー",
