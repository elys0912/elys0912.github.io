      "draft": false,
      "title": "-a"
    },
    {
      "name": "1st は数値ではなく文字列",
      "lines": ["---","title: 1st","summary: s","publishedAt: 2026-10-01T09:00:00+09:00","---","本文"],
      "expect": "post",
      "draft": false,
      "title": "1st"
    },
    {
      "name": "null の summary はエラー",
