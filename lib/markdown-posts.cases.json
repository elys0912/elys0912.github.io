      "expect": "error"
    },
    {
      "name": "[ で始まる title はエラー",
      "lines": ["---","title: [a, b]","summary: s","publishedAt: 2026-10-01T09:00:00+09:00","---","本文"],
      "expect": "error"
    },
    {
      "name": "\"…\" の中の \\\" と \\\\ は 1 字",
      "lines": ["---","title: \"a \\\"b\\\" \\\\ c # 続き\" # コメント","summary: s","publishedAt: 2026-10-01T09:00:00+09:00","---","本文"],
      "expect": "post",
      "draft": false,
      "title": "a \"b\" \\ c # 続き"
    },
    {
      "name": "\"…\" の中の \\/ はエラー",
      "lines": ["---","title: \"a\\/b\"","summary: s","publishedAt: 2026-10-01T09:00:00+09:00","---","本文"],
