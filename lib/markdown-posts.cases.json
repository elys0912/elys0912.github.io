      "expect": "error"
    },
    {
      "name": "'…' の中の '' は ' 1 字",
      "lines": ["---","title: 'it''s'","summary: s","publishedAt: 2026-10-01T09:00:00+09:00","---","本文"],
      "expect": "post",
      "draft": false,
      "title": "it's"
