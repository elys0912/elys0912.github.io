    {
      "name": "素の文字列の中のタブは残し、タブの後の # からはコメント",
      "lines": ["---","title: a\tb\t# コメント","summary: s","publishedAt: 2026-10-01T09:00:00+09:00","---","本文"],
      "expect": "post",
      "draft": false,
      "title": "a\tb"
    },
    {
